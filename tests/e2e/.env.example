# Copy this file to tests/e2e/.env and fill values for local runs
E2E_BASE_URL=https://staging.example.com
E2E_SUPERADMIN_EMAIL=superadmin@example.com
E2E_SUPERADMIN_PASSWORD=changeme
E2E_OWNER_EMAIL=owner@example.com
E2E_OWNER_PASSWORD=changeme

# Optional
E2E_HEADLESS=false
E2E_SLOW_MO_MS=0
E2E_ARTIFACT_DIR=tests/e2e/artifacts
E2E_ALLOW_PROD=false
E2E_RUN_ID=local
# Optionally set explicit python executable path to use for pnpm scripts
#E2E_PYTHON=C:\Users\adiba\AppData\Local\Python\pythoncore-3.14-64\python.exe
