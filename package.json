{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:install": "powershell -NoProfile -ExecutionPolicy Bypass -File tests\\e2e\\run-e2e.ps1 install",
    "e2e:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File tests\\e2e\\run-e2e.ps1 smoke",
    "e2e:journey": "powershell -NoProfile -ExecutionPolicy Bypass -File tests\\e2e\\run-e2e.ps1 journey",
    "e2e:crawl": "powershell -NoProfile -ExecutionPolicy Bypass -File tests\\e2e\\run-e2e.ps1 crawl",
    "e2e:full": "powershell -NoProfile -ExecutionPolicy Bypass -File tests\\e2e\\run-e2e.ps1 full",
    "e2e:staging": "pnpm e2e:full",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:journey": "playwright test --grep @journey",
    "test:e2e:rbac": "playwright test --grep @rbac",
    "test:e2e:regression": "playwright test --grep @regression",
    "test:e2e:report": "playwright show-report tests/e2e/artifacts/playwright-report",
    "test:e2e:install": "playwright install chromium",
    "prepare": "husky",
    "pages:deploy:staging": "wrangler pages deploy out --project-name titanjournal-crm-staging",
    "pages:deploy:prod": "wrangler pages deploy out --project-name titanjournal"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@iconify/react": "^6.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.19",
    "@tiptap/extension-character-count": "^3.20.0",
    "@tiptap/extension-link": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-konva": "^19.2.3",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "styled-components": "^6.3.11",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "happy-dom": "^20.8.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wrangler": "^4.71.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --no-warn-ignored"
    ]
  }
}
